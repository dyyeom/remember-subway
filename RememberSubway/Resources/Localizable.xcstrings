{
  "sourceLanguage" : "en",
  "strings" : {
    "?" : {
      "comment" : "A placeholder for a station name.",
      "isCommentAutoGenerated" : true
    },
    "%@" : {
      "comment" : "A countdown timer displayed in the center of the screen. The number inside the parentheses is the countdown value.",
      "isCommentAutoGenerated" : true
    },
    "%@ / %@" : {
      "comment" : "A label that shows the current station index and total number of stations.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ / %2$@"
          }
        }
      }
    },
    "%@/%@" : {
      "comment" : "A label displaying the current round index and the total number of rounds. The first argument is the current round index. The second argument is the total number of rounds.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@/%2$@"
          }
        }
      }
    },
